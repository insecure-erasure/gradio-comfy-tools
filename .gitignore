# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Unit test / coverage reports
.pytest_cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# Tool caches (pip, uv, ruff, mypy, … create these at runtime)
.cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
cython_debug/

# Environments (local virtualenvs — see .venv/ used by this repo)
.venv/
venv/
env/
ENV/

# Secrets / local overrides
.env
.env.*

# Application runtime (server.py writes uploaded files here before
# forwarding them to ComfyUI — never commit leftover uploads)
tmp_uploads/

# Logs
*.log

# Editor / IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
